# Node 22+, npm workspaces. The resolver loads the root .env automatically.
PORT=8787
HOST=127.0.0.1
RESOLVER_MODE=mock

# Mock HTTP ledger for separately running frontend apps. Local is the default:
# requires loopback HOST, loopback clients, and allowed browser origins.
MOCK_HTTP_ENABLED=true
MOCK_HTTP_ACCESS=local
# Defaults allow localhost/127.0.0.1 on ports 5173, 3000 and 4173.
# MOCK_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# For an explicitly authenticated remote demo: set access=token, a token of at
# least 32 characters, exact allowed origins, and an appropriate HOST.
# MOCK_API_TOKEN=<random-demo-access-token>

# Omit to use <repository>/.data/resolver.sqlite. Use an absolute override.
# RESOLVER_DB_PATH=/absolute/path/to/resolver.sqlite
MAX_EVENT_AGE_SECONDS=300
MAX_FUTURE_SKEW_SECONDS=30

# Optional base58 PUBLIC identities for standalone mock mode.
# Mock wallets cannot sign blockchain transactions.
# RESOLVER_PUBLIC_KEY=
# MOCK_CREATOR_PUBLIC_KEY=

# Real mode currently fails with CONTRACT_UNAVAILABLE until Developer A's IDL
# and actual contract details are integrated. It never falls back to mock.
SOLANA_RPC_URL=https://api.devnet.solana.com
HUNCH_PROGRAM_ID=
TEST_TOKEN_MINT=

# Future server-only resolver signer. Not loaded by the blocked Anchor adapter.
# Keep real key files outside git and never deliver them to a browser.
RESOLVER_KEYPAIR_PATH=./.keys/resolver.json
