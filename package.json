{
  "name": "hunch",
  "version": "0.1.0",
  "private": true,
  "description": "hunch — embeddable on-chain prediction markets on Solana. HackRU 2026.",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "sdk": "npm run build --workspace @hunch/sdk",
    "resolver": "npm run dev --workspace @hunch/resolver",
    "dev": "npm run dev --workspace @hunch/racing",
    "dashboard": "npm run dev --workspace @hunch/dashboard",
    "esports": "npm run dev --workspace @hunch/esports"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
