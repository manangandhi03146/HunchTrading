{
  "name": "marketkit",
  "version": "0.1.0",
  "private": true,
  "description": "MarketKit — embeddable on-chain prediction markets on Solana. HackRU 2026.",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "sdk": "npm run build --workspace @marketkit/sdk",
    "resolver": "npm run dev --workspace @marketkit/resolver"
  },
  "engines": {
    "node": ">=18"
  }
}
