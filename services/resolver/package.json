{
  "name": "@marketkit/resolver",
  "version": "0.1.0",
  "description": "MarketKit resolver — verifies signed game results and submits on-chain resolution.",
  "type": "module",
  "main": "dist/public.js",
  "types": "dist/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    }
  },
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "demo": "node --import tsx src/demo.ts",
    "register": "node --import tsx src/register.ts",
    "sign-event": "node --import tsx src/sign-event.ts",
    "submit-event": "node --import tsx src/submit-event.ts",
    "reconcile": "node --import tsx src/reconcile.ts"
  },
  "dependencies": {
    "@hunch/sdk": "*",
    "@solana/web3.js": "^1.98.4",
    "fastify": "^5.6.0",
    "@fastify/cors": "^11.1.0",
    "zod": "^4.1.12",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^16.6.1",
    "tweetnacl": "^1.0.3",
    "@solana/spl-token": "^0.4.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@coral-xyz/anchor": "0.32.1"
  }
}
